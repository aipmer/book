# ============================================
# Ch.10 SaaS MVP 环境变量模版
# 复制为 .env 后填入真实值：cp .env.example .env
# ============================================

# Supabase PostgreSQL 连接串（Settings -> Database -> Connection String）
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth（Settings -> API）
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Stripe（Dashboard -> Developers -> API keys）
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PRICE_ID="price_..."   # 订阅制 Price ID（ recurring ）

# Stripe Webhook 签名密钥：本地调试用 `npm run stripe:listen` 控制台输出的 whsec_xxx
STRIPE_WEBHOOK_SECRET="whsec_..."

# OpenAI（翻译引擎）
OPENAI_API_KEY="sk-..."
